# Copy to .env and fill in:  cp .env.example .env

# ---------- Database ----------
POSTGRES_USER=ruleguarder
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ruleguarder
# Host port for Postgres (only needed if you want to connect from your machine)
POSTGRES_PORT=5432
# The server's DATABASE_URL is built from the values above in docker-compose.yml.
# Set it here only when running the server outside Docker:
# DATABASE_URL=postgresql+psycopg://ruleguarder:change-me@localhost:5432/ruleguarder

# ---------- Server ----------
SERVER_PORT=8000
LOG_LEVEL=info
MAX_UPLOAD_MB=20
# Origins allowed to call the API directly (the client normally goes through the /api proxy)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------- LLM ----------
# Documents are sent to this provider for checking. For sensitive documents,
# make sure this is allowed by your security policy (or plug in a self-hosted provider).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  - higher = more thorough, slower, more expensive
LLM_EFFORT=high
LLM_MAX_TOKENS=32000
# Long documents are split into chunks of about this many characters, checked in parallel
LLM_CHUNK_CHARS=60000
LLM_MAX_PARALLEL=4

# ---------- Client ----------
# Production client (nginx) port
CLIENT_PORT=8080
# Dev client (Vite) port - used by docker-compose.dev.yml
CLIENT_DEV_PORT=5173
