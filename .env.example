# Copy to .env and fill in:  cp .env.example .env

# ---------- Database ----------
POSTGRES_USER=ruleguarder
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ruleguarder
# Host port for Postgres - dev override only (5433 to avoid clashing with a local Postgres)
POSTGRES_PORT=5433
# The server's DATABASE_URL is built from the values above in docker-compose.yml.
# Set it here only when running the server outside Docker:
# DATABASE_URL=postgresql+psycopg://ruleguarder:change-me@localhost:5432/ruleguarder

# ---------- Server ----------
SERVER_PORT=8000
LOG_LEVEL=info
MAX_UPLOAD_MB=20
# Origins allowed to call the API directly (the client normally goes through the /api proxy)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------- LLM (Google Gemini) ----------
# Get a free key at https://aistudio.google.com/apikey
# WARNING: on the FREE tier, Google may use submitted content to improve its products.
# Do not upload confidential documents unless your organisation has approved this
# (a paid / Vertex AI project has different data terms).
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
# gemini-3.5-flash works on the free tier (checked 2026-09-29). Newer flash models were
# overloaded (503) at that time; pro models have no free-tier quota (429).
LLM_MODEL=gemini-3.5-flash
# Optional, comma-separated: tried in order if LLM_MODEL is overloaded (503/504/timeout).
# Every fallback attempt is another request against your quota.
LLM_FALLBACK_MODELS=
LLM_MAX_TOKENS=32000
# Uncomment to override the model's default temperature
# LLM_TEMPERATURE=0.2
# Retries per model on 429 (rate limit). Each retry is an extra request.
LLM_MAX_RETRIES=1
LLM_TIMEOUT_SECONDS=120
# Long documents are split into chunks of about this many characters
LLM_CHUNK_CHARS=60000
# Parallel LLM calls per check - keep low on the free tier (per-minute quota)
LLM_MAX_PARALLEL=1

# ---------- Client ----------
# Production client (nginx) port
CLIENT_PORT=8080
# Dev client (Vite) port - used by docker-compose.dev.yml
CLIENT_DEV_PORT=5173
